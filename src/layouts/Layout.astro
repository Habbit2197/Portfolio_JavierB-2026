---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Javier Barrientos | Dev & Terminal Portfolio",
  description = "Portafolio de Javier Barrientos Montes en modo terminal de desarrollador. Full-Stack & Mobile Developer."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Google Fonts: Fira Code -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Línea de escaneo CRT sutil para atmósfera dev -->
    <div class="scanlines" aria-hidden="true"></div>

    <!-- Barra de navegación estilo Terminal Prompt -->
    <header class="terminal-nav">
      <div class="nav-wrapper">
        <a href="#top" class="prompt-brand">
          <span class="prompt-prefix">root@jbm:</span><span class="prompt-path">~#</span>
          <span class="prompt-cursor">_</span>
        </a>

        <nav class="prompt-links">
          <a href="#about" class="prompt-link">[01_about]</a>
          <a href="#skills" class="prompt-link">[02_skills]</a>
          <a href="#projects" class="prompt-link">[03_projects]</a>
          <a href="#contact" class="prompt-link contact-pill">[04_contact]</a>
        </nav>
      </div>
    </header>

    <!-- Contenedor Principal -->
    <main id="top" class="terminal-container">
      <slot />
    </main>

    <!-- Footer Terminal -->
    <footer class="terminal-footer">
      <div class="footer-wrapper">
        <p class="footer-prompt">
          <span class="dim">// EOF ----------------------------------------------------</span>
        </p>
        <p class="footer-info">
          <span>HOST: usal-node-01</span>
          <span>•</span>
          <span>BUILD: Astro v5.18</span>
          <span>•</span>
          <span class="status-active">SYSTEM: ONLINE (0x4A424D)</span>
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg-page: #050505;
    --bg-surface: #0c0c0c;
    --bg-card: #050505;
    --border-color: #333333;
    --border-neon: #00ff41;

    --text-primary: #a0a0a0;
    --text-bright: #e5e5e5;
    --text-muted: #555555;
    --accent: #00ff41;
    --accent-dim: rgba(0, 255, 65, 0.12);
    --accent-amber: #ffb000;

    --font-mono: 'Fira Code', 'Courier New', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

    color-scheme: dark;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    background-color: var(--bg-page);
    color: var(--text-primary);
    font-family: var(--font-mono);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--bg-page);
    position: relative;
    overflow-x: hidden;
  }

  /* Efecto CRT scanline muy sutil */
  .scanlines {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: linear-gradient(
      rgba(18, 16, 16, 0) 50%,
      rgba(0, 0, 0, 0.25) 50%
    );
    background-size: 100% 4px;
    z-index: 99;
    pointer-events: none;
    opacity: 0.4;
  }

  /* Header Terminal */
  .terminal-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(5, 5, 5, 0.95);
    border-bottom: 1px solid var(--border-color);
    backdrop-filter: blur(8px);
  }

  .nav-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.85rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.88rem;
  }

  .prompt-brand {
    text-decoration: none;
    color: var(--text-bright);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
  }

  .prompt-prefix {
    color: var(--accent);
  }

  .prompt-path {
    color: var(--text-bright);
    margin-left: 0.15rem;
  }

  .prompt-cursor {
    color: var(--accent);
    animation: blink-cursor 1s step-end infinite;
    margin-left: 0.15rem;
  }

  @keyframes blink-cursor {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .prompt-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .prompt-link {
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.82rem;
    transition: color 0.15s ease;
  }

  .prompt-link:hover {
    color: var(--accent);
  }

  .contact-pill {
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 0.2rem 0.6rem;
    border-radius: 2px;
    background: var(--accent-dim);
  }

  .contact-pill:hover {
    background: var(--accent);
    color: #000;
  }

  /* Contenedor Principal */
  .terminal-container {
    flex: 1;
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }

  /* Estilos Globales para Barras de Progreso Terminal */
  .skill-metric-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.85rem;
    font-family: var(--font-mono);
  }

  .skill-label-text {
    color: var(--text-bright);
    font-size: 0.88rem;
  }

  .skill-progress-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
  }

  .progress-blocks {
    color: var(--accent);
    letter-spacing: 2px;
  }

  .progress-percent {
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* Footer */
  .terminal-footer {
    border-top: 1px solid var(--border-color);
    background: #050505;
    padding: 2rem 1.5rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .footer-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-prompt .dim {
    color: #333;
  }

  .footer-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .status-active {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .nav-wrapper {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }

    .prompt-links {
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .terminal-container {
      padding: 1.5rem 1rem 4rem;
    }
  }
</style>
