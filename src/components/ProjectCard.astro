---
interface Props {
  project?: {
    data: {
      title: string;
      description: string;
      tags: string[];
      category: string;
      image?: string;
      link?: string;
      featured?: boolean;
    };
  };
  title?: string;
  description?: string;
  tags?: string[];
  category?: string;
  image?: string;
  link?: string;
  featured?: boolean;
  class?: string;
}

const { project: propProject, class: className = '' } = Astro.props;

// Soporte completo tanto si se pasa `project={project}` como si se pasan props desestructuradas
const project = propProject || {
  data: {
    title: Astro.props.title || '',
    description: Astro.props.description || '',
    tags: Astro.props.tags || [],
    category: Astro.props.category || '',
    image: Astro.props.image,
    link: Astro.props.link,
    featured: Astro.props.featured ?? false,
  },
};
---

<article class:list={['project-card', 'terminal-card', className]}>
  <!-- Imagen como hija DIRECTA del contenedor principal (sin wrappers) -->
  {project.data.image && (
    <img
      src={project.data.image}
      alt={`Captura de ${project.data.title}`}
      loading="lazy"
      class="card-image"
    />
  )}

  <!-- Contenedor único para todo el contenido de texto -->
  <div class="card-content">
    <!-- Encabezado de la tarjeta: Categoría y badges estilo consola -->
    <div class="card-meta">
      <span class="category-badge">
        <span class="badge-prefix">&gt;</span> {project.data.category}
      </span>

      <div class="meta-right">
        {project.data.featured && (
          <span class="featured-badge" title="Proyecto Destacado">
            [★_FEATURED]
          </span>
        )}

        {project.data.link && (
          <a
            href={project.data.link}
            target="_blank"
            rel="noopener noreferrer"
            class="external-link"
            aria-label={`Ver proyecto ${project.data.title}`}
            title="Abrir enlace"
          >
            <span class="link-label">EXEC</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        )}
      </div>
    </div>

    <!-- Cuerpo: Título y descripción -->
    <div class="card-body">
      <h3 class="card-title">
        {project.data.link ? (
          <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="title-link">
            {project.data.title}
          </a>
        ) : (
          project.data.title
        )}
      </h3>
      <p class="card-description">{project.data.description}</p>
    </div>

    <!-- Etiquetas / Tags -->
    {project.data.tags && project.data.tags.length > 0 && (
      <div class="card-tags">
        {project.data.tags.map((tag) => (
          <span class="tag-pill">
            <span class="tag-flag">--</span>{tag.toLowerCase().replace(/\s+/g, '-')}
          </span>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  /* 1. Contenedor principal de la tarjeta */
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    border-radius: 2px;
    background: #000000;
    border: 1px solid #333333;
    font-family: var(--font-mono, monospace);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  /* Hover de la caja de terminal */
  .project-card:hover {
    border-color: #00ff41;
    box-shadow: 0 0 15px rgba(0, 255, 65, 0.2), inset 0 0 10px rgba(0, 255, 65, 0.03);
    transform: translateY(-2px);
  }

  /* 3. CSS exacto requerido para la imagen */
  img.card-image {
    width: 100%;
    height: 220px;
    object-fit: cover;
    object-position: center top;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid #333;
  }

  .project-card:hover img.card-image {
    border-bottom-color: #00ff41;
  }

  /* 4. Contenedor de contenido de texto con padding */
  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    flex-grow: 1;
    justify-content: space-between;
  }

  /* Metadata / Categoría */
  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .category-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    background: rgba(0, 255, 65, 0.05);
    border: 1px solid rgba(0, 255, 65, 0.3);
    color: #00ff41;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .badge-prefix {
    color: #00ff41;
    font-weight: 700;
  }

  .meta-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .featured-badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
    background: rgba(255, 176, 0, 0.1);
    border: 1px solid #ffb000;
    color: #ffb000;
    letter-spacing: 0.03em;
  }

  .external-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    background: #111111;
    border: 1px solid #333333;
    color: #a0a0a0;
    text-decoration: none;
    font-size: 0.72rem;
    font-weight: 600;
    transition: all 0.15s ease;
  }

  .external-link:hover {
    color: #000000;
    background: #00ff41;
    border-color: #00ff41;
  }

  .link-label {
    letter-spacing: 0.05em;
  }

  /* Cuerpo */
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex-grow: 1;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
    color: #e5e5e5;
    letter-spacing: -0.01em;
  }

  .title-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .title-link:hover {
    color: #00ff41;
  }

  .card-description {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #a0a0a0;
  }

  /* Tags */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px dashed #222222;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
    background: #0d0d0d;
    border: 1px solid #222222;
    color: #777777;
    font-size: 0.75rem;
    transition: all 0.15s ease;
  }

  .tag-pill:hover {
    color: #a0a0a0;
    border-color: #444444;
  }

  .tag-flag {
    color: #00ff41;
    margin-right: 1px;
    opacity: 0.7;
  }

  @media (max-width: 640px) {
    .card-content {
      padding: 1.2rem;
    }

    img.card-image {
      height: 190px;
    }

    .card-title {
      font-size: 1.15rem;
    }
  }
</style>
