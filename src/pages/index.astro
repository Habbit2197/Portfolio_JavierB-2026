---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');

// Priorizar proyectos destacados
const projects = allProjects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return 0;
});

const skills = [
  { name: 'iOS / Swift', bar: '▓▓▓▓▓▓▓▓▓░', value: '90' },
  { name: 'UI/UX & Diseño', bar: '▓▓▓▓▓▓▓▓▓░', value: '90' },
  { name: 'Astro & Vanilla JS', bar: '▓▓▓▓▓▓▓▓░░', value: '85' },
  { name: 'PHP & Bases de Datos', bar: '▓▓▓▓▓▓▓▓░░', value: '85' },
  { name: 'Flutter & DAM', bar: '▓▓▓▓▓▓▓▓░░', value: '80' },
  { name: 'Infraestructura Web', bar: '▓▓▓▓▓▓▓▓░░', value: '80' },
];
---

<Layout
  title="Javier Barrientos | Dev & Terminal Portfolio"
  description="Full-Stack Software & Mobile Developer en modo terminal. Arquitecturas nativas, interfaces fluidas y software a medida."
>
  <!-- 1. HERO SECTION (ASCII ART Y FICHA) -->
  <section id="about" class="terminal-block terminal-reveal">
    <div class="terminal-frame">
      <div class="frame-bar">
        <span class="btn-ctrl"></span>
        <span class="btn-ctrl"></span>
        <span class="btn-ctrl"></span>
        <span class="frame-title">session_0x4A424D.sh</span>
      </div>
      <div class="frame-content">
        <pre class="ascii-output">
   ╔══════════════╗
   ║ ░░██████░░░░ ║
   ║ ░██░░░░██░░░ ║
   ║ ██▓▓▓▓▓▓██░░ ║
   ║ ██▓██▓▓██▓██ ║
   ║ ██▓▓▓██▓▓▓██ ║
   ║ ██▓██████▓██ ║
   ║ ░██▓▓▓▓▓▓██░ ║
   ║ ░░████████░░ ║
   ╚══════════════╝
   [ ID: 0x4A424D ]
   name: Javier Barrientos
   role: Full-Stack & Mobile Dev
   study: DAM & Diseño Gráfico
   org: Fundación General USAL
   location: Salamanca · ES
   status: // ACTIVE</pre>
      </div>
    </div>
  </section>

  <!-- 2. MÓDULOS DE TEXTO (EJECUCIÓN DE FUNCIONES) -->
  <section class="terminal-block functions-section">
    <div class="func-group">
      <!-- quien.es() -->
      <article class="func-card terminal-reveal">
        <h2 class="func-title">
          <span class="prefix">&gt;</span> quien.es()<span class="func-cursor">_</span>
        </h2>
        <p class="func-body">
          Desarrollador Full-Stack donde la ingeniería de software y el diseño gráfico colisionan. De día, arquitecto de sistemas en la Fundación General de la Universidad de Salamanca. De noche, creador de ecosistemas móviles y web que combinan lógica pura con interfaces perfectas.
        </p>
      </article>

      <!-- como.trabajo() -->
      <article class="func-card terminal-reveal">
        <h2 class="func-title">
          <span class="prefix">&gt;</span> como.trabajo()<span class="func-cursor">_</span>
        </h2>
        <p class="func-body">
          Control total sobre el ecosistema. Desde el prototipado visual y UI/UX, hasta el despliegue de bases de datos y desarrollo nativo (DAM). Si el backend es sólido pero el diseño falla, no sirve. Si es bonito pero lento, tampoco. Equilibrio puro.
        </p>
      </article>

      <!-- filosofia.txt -->
      <article class="func-card terminal-reveal">
        <h2 class="func-title">
          <span class="prefix">&gt;</span> filosofia.txt<span class="func-cursor">_</span>
        </h2>
        <p class="func-body">
          El código es arte funcional. Creo en interfaces limpias impulsadas por arquitecturas robustas. Un buen desarrollador no solo pica código, diseña experiencias.
        </p>
      </article>
    </div>
  </section>

  <!-- 3. MÓDULO DE HABILIDADES (BARRAS DE PROGRESO) -->
  <section id="skills" class="terminal-block terminal-reveal">
    <div class="section-tag-header">
      <span class="tag-accent">// SYS_MODULE: CAPABILITIES</span>
      <h2 class="section-headline">DEV_MODE OPERATIVO</h2>
    </div>

    <div class="skills-terminal-grid">
      {skills.map((skill) => (
        <div class="skill-item-box">
          <div class="skill-meta">
            <span class="skill-name">{skill.name}</span>
          </div>
          <div class="skill-progress">
            <span class="bar-ascii">{skill.bar}</span>
            <span class="val-ascii">{skill.value}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 4. GRID DE PROYECTOS -->
  <section id="projects" class="terminal-block">
    <div class="section-tag-header terminal-reveal">
      <span class="tag-accent">// REPOSITORY: /var/www/deployments/</span>
      <h2 class="section-headline">&gt; ls -la /proyectos_desplegados/<span class="func-cursor">_</span></h2>
    </div>

    <div class="projects-console-grid">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- 5. FOOTER (CONEXIÓN) -->
  <section id="contact" class="terminal-block connection-section terminal-reveal">
    <div class="connection-frame">
      <div class="connection-header">
        <span class="header-prompt">06_establish_connection</span>
      </div>
      <div class="connection-body">
        <h3 class="connect-question">¿hablamos?</h3>
        <p class="connect-sub">
          Si tienes algo que diseñar, desarrollar, automatizar o optimizar — el canal está abierto.
        </p>

        <div class="connect-links">
          <div class="channel-row">
            <span class="channel-prefix">// LINKEDIN:</span>
            <a
              href="https://www.linkedin.com/in/javier-barrientos-montes"
              target="_blank"
              rel="noopener noreferrer"
              class="channel-link"
            >
              /in/Javier Barrientos Montes
            </a>
          </div>

          <div class="channel-row">
            <span class="channel-prefix">// GITHUB:</span>
            <a
              href="https://github.com/Habbit2197"
              target="_blank"
              rel="noopener noreferrer"
              class="channel-link"
            >
              /Habbit2197
            </a>
          </div>

          <div class="channel-row">
            <span class="channel-prefix">// EMAIL:</span>
            <a
              href="mailto:javier.barmont97@outlook.es"
              class="channel-link accent"
            >
              javier.barmont97@outlook.es
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PASO 4: ANIMACIONES VANILLA JS (NIVEL TERMINAL) -->
  <script is:inline>
    // 1. INTERSECTION OBSERVER PARA REVELADO LÍNEA A LÍNEA ESTILO TERMINAL
    const revealOptions = {
      root: null,
      rootMargin: "0px 0px -40px 0px",
      threshold: 0.1,
    };

    const terminalObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("revealed");
          observer.unobserve(entry.target);
        }
      });
    }, revealOptions);

    document.querySelectorAll(".terminal-reveal, .project-card").forEach((elem) => {
      terminalObserver.observe(elem);
    });

    // 2. EFECTO BLINKING CURSOR EN TÍTULOS DE FUNCIONES
    // (Gestionado por CSS con @keyframes blink-cursor para máximo rendimiento de 60fps)
  </script>
</Layout>

<style>
  /* ==========================================================================
     ESTILOS BASE DEL MODO TERMINAL
     ========================================================================== */
  .terminal-block {
    margin-bottom: 4rem;
  }

  /* Animación Reveal estilo terminal */
  .terminal-reveal {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s cubic-bezier(0.1, 1, 0.2, 1),
                transform 0.4s cubic-bezier(0.1, 1, 0.2, 1);
  }

  .terminal-reveal.revealed,
  :global(.project-card.revealed) {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }

  /* 1. HERO SECTION */
  .terminal-frame {
    border: 1px solid #333333;
    background: #000000;
    border-radius: 2px;
    overflow: hidden;
  }

  .frame-bar {
    background: #0d0d0d;
    border-bottom: 1px solid #333333;
    padding: 0.45rem 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: #777777;
  }

  .btn-ctrl {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #333333;
    display: inline-block;
  }

  .btn-ctrl:nth-child(1) { background: #ff5f56; }
  .btn-ctrl:nth-child(2) { background: #ffbd2e; }
  .btn-ctrl:nth-child(3) { background: #27c93f; }

  .frame-title {
    margin-left: 0.5rem;
    color: #888888;
  }

  .frame-content {
    padding: 1.5rem;
    background: #050505;
  }

  .ascii-output {
    font-family: var(--font-mono, monospace);
    font-size: clamp(0.78rem, 1.8vw, 0.95rem);
    line-height: 1.35;
    color: #00ff41;
    margin: 0;
    white-space: pre-wrap;
    text-shadow: 0 0 6px rgba(0, 255, 65, 0.35);
  }

  /* 2. FUNCIONES EJECUTÁNDOSE */
  .functions-section {
    margin-top: 3rem;
  }

  .func-group {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .func-card {
    border-left: 2px solid #333333;
    padding-left: 1.25rem;
    transition: border-left-color 0.2s ease;
  }

  .func-card:hover {
    border-left-color: #00ff41;
  }

  .func-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: #e5e5e5;
    margin-bottom: 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .func-title .prefix {
    color: #00ff41;
    font-weight: 700;
  }

  .func-cursor {
    color: #00ff41;
    animation: blink-cursor 1s step-end infinite;
    display: inline-block;
  }

  @keyframes blink-cursor {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .func-body {
    font-size: 0.92rem;
    line-height: 1.7;
    color: #a0a0a0;
    max-width: 820px;
  }

  /* 3. MÓDULO DE HABILIDADES */
  .section-tag-header {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .tag-accent {
    font-size: 0.75rem;
    color: #555555;
    letter-spacing: 0.05em;
  }

  .section-headline {
    font-size: 1.35rem;
    font-weight: 700;
    color: #e5e5e5;
    letter-spacing: -0.01em;
  }

  .skills-terminal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    background: #000000;
    border: 1px solid #333333;
    padding: 1.5rem;
    border-radius: 2px;
  }

  .skill-item-box {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.75rem;
    background: #050505;
    border: 1px solid #1a1a1a;
    border-radius: 2px;
    transition: border-color 0.2s ease;
  }

  .skill-item-box:hover {
    border-color: #333333;
  }

  .skill-name {
    font-size: 0.86rem;
    color: #e5e5e5;
    font-weight: 500;
  }

  .skill-progress {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.88rem;
  }

  .bar-ascii {
    color: #00ff41;
    letter-spacing: 1px;
    text-shadow: 0 0 4px rgba(0, 255, 65, 0.3);
  }

  .val-ascii {
    color: #a0a0a0;
    font-size: 0.82rem;
    font-weight: 600;
  }

  /* 4. GRID DE PROYECTOS */
  .projects-console-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  /* 5. FOOTER (CONEXIÓN) */
  .connection-section {
    margin-top: 5rem;
  }

  .connection-frame {
    border: 1px solid #333333;
    background: #000000;
    border-radius: 2px;
    overflow: hidden;
  }

  .connection-header {
    background: #0d0d0d;
    border-bottom: 1px solid #333333;
    padding: 0.5rem 1rem;
    font-size: 0.78rem;
    color: #00ff41;
    font-weight: 600;
  }

  .connection-body {
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .connect-question {
    font-size: 1.6rem;
    font-weight: 700;
    color: #e5e5e5;
    letter-spacing: -0.02em;
  }

  .connect-sub {
    font-size: 0.95rem;
    line-height: 1.65;
    color: #a0a0a0;
    max-width: 650px;
  }

  .connect-links {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px dashed #222222;
  }

  .channel-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.88rem;
    flex-wrap: wrap;
  }

  .channel-prefix {
    color: #666666;
    min-width: 110px;
  }

  .channel-link {
    color: #e5e5e5;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .channel-link:hover {
    color: #00ff41;
    text-decoration: underline;
  }

  .channel-link.accent {
    color: #00ff41;
  }

  @media (max-width: 640px) {
    .ascii-output {
      font-size: 0.68rem;
    }

    .frame-content {
      padding: 1rem;
    }

    .skills-terminal-grid {
      grid-template-columns: 1fr;
      padding: 1rem;
    }

    .projects-console-grid {
      grid-template-columns: 1fr;
    }

    .channel-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
    }
  }
</style>
